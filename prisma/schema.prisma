// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApiKey {
  id         String    @id @default(cuid())
  // SECURITY: never store the plaintext key. Store a non-secret prefix
  // (first 8 hex chars after `dzk_`) for fast indexed lookup, and a SHA-256
  // hash of the full key for constant-time verification.
  keyPrefix  String    @unique
  keyHash    String    @unique
  emailCount Int       @default(0)
  maxEmails  Int       @default(3)
  expired    Boolean   @default(false)
  expiredAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  notes      String?
  lastUsedAt DateTime?
  lastEmail  String?
  // Audit trail for abuse detection (without storing IP itself — store a
  // salted hash of IP so we can correlate bursts from same IP without
  // leaking the IP if the DB is dumped).
  createdIpHash String?

  @@index([keyPrefix])
  @@map("api_keys")
}